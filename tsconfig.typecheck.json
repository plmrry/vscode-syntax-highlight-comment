{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "./",
    "tsBuildInfoFile": "node_modules/.tsbuildinfo-typecheck"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.test.ts",
    "test-support/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": []
}

{
  "name": "vscode-syntax-highlight-comment",
  "displayName": "Syntax Highlight Comment",
  "version": "2026.9.5999994",
  "description": "Enable syntax highlighting in template literals using comment markers like /** css */.",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "css",
    "html",
    "javascript",
    "shell",
    "syntax highlighting",
    "template literal",
    "typescript",
    "vscode"
  ],
  "license": "CC0-1.0",
  "author": "paul-murray",
  "repository": {
    "type": "git",
    "url": "https://github.com/plmrry/vscode-syntax-highlight-comment"
  },
  "publisher": "paul-murray",
  "files": [
    "CHANGELOG.md",
    "LICENSE.md",
    "README.md",
    "icon.png",
    "package.json",
    "src",
    "syntaxes",
    "ts-out"
  ],
  "type": "module",
  "main": "./ts-out/extension.js",
  "types": "./ts-out/extension.d.ts",
  "scripts": {
    "build-grammar": "node ./scripts/build-grammar.mjs",
    "format": "oxfmt --write .",
    "lint": "oxlint --fix-dangerously .",
    "check": "npm run format && npm run lint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "prebuild": "npm run build-grammar && npm run check && npm run typecheck && npm test",
    "build": "tsc --build",
    "prepackage": "npm run build",
    "package": "vsce package",
    "postpackage": "vsce publish patch"
  },
  "devDependencies": {
    "@types/node": "26",
    "@types/vscode": "1.136.x",
    "@vscode/vsce": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "7.0.2",
    "vitest": "^4.1.11"
  },
  "contributes": {
    "commands": [
      {
        "command": "syntaxHighlightComment.showSupportedMarkers",
        "title": "Syntax Highlight Comment: Show Supported Markers"
      }
    ],
    "grammars": [
      {
        "scopeName": "source.syntax-highlight-comment.injection",
        "path": "./syntaxes/syntax-highlight-comment.tmLanguage.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.syntax-highlight-comment.css": "css",
          "meta.embedded.block.syntax-highlight-comment.html": "html",
          "meta.embedded.block.syntax-highlight-comment.js": "javascript",
          "meta.embedded.block.syntax-highlight-comment.jsx": "javascriptreact",
          "meta.embedded.block.syntax-highlight-comment.ts": "typescript",
          "meta.embedded.block.syntax-highlight-comment.tsx": "typescriptreact",
          "meta.embedded.block.syntax-highlight-comment.shell": "shellscript",
          "meta.embedded.block.syntax-highlight-comment.svg": "xml"
        },
        "tokenTypes": {
          "meta.embedded.block.syntax-highlight-comment.css": "other",
          "meta.embedded.block.syntax-highlight-comment.html": "other",
          "meta.embedded.block.syntax-highlight-comment.js": "other",
          "meta.embedded.block.syntax-highlight-comment.jsx": "other",
          "meta.embedded.block.syntax-highlight-comment.ts": "other",
          "meta.embedded.block.syntax-highlight-comment.tsx": "other",
          "meta.embedded.block.syntax-highlight-comment.shell": "other",
          "meta.embedded.block.syntax-highlight-comment.svg": "other"
        }
      }
    ]
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "icon": "icon.png",
  "engines": {
    "node": "24.x",
    "npm": "11.x",
    "vscode": "^1.136.0"
  },
  "packageManager": "npm@11.9.0",
  "pricing": "Free",
  "vsce": {
    "out": "vsix-file",
    "githubBranch": "main"
  }
}
